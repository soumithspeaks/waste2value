# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waste2value
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_API_KEY=your_mapbox_api_key

# Payment Gateway (Razorpay/Stripe)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# AWS Configuration (for S3, SES, etc.)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=waste2value-uploads

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# AI/ML Model Configuration
ML_MODEL_ENDPOINT=http://localhost:5000/predict
ML_MODEL_API_KEY=your_ml_api_key
ML_CONFIDENCE_THRESHOLD=0.85

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@waste2value.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# WebSocket
SOCKET_IO_CORS_ORIGIN=*

# Pricing Configuration (per kg)
PRICE_ORGANIC=2.00
PRICE_PLASTIC=5.00
PRICE_PAPER=3.00
PRICE_METAL=10.00
PRICE_GLASS=4.00
PRICE_EWASTE=15.00
PRICE_HAZARDOUS=1.00

# Agent Commission (percentage)
AGENT_COMMISSION_RATE=0.20

# Platform Configuration
MIN_PICKUP_WEIGHT=1
MAX_PICKUP_WEIGHT=1000
AGENT_SEARCH_RADIUS_KM=10
AGENT_MATCHING_TIMEOUT_SEC=30
